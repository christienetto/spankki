# Crosskey developer portal → Applications → your application
SPANKKI_CLIENT_ID=
SPANKKI_API_KEY=

# Must exactly match a redirect URL registered on the application.
SPANKKI_REDIRECT_URI=http://localhost:8080/callback

# PEM files from the Crosskey portal (Team → certificates). Keys must be unencrypted RSA.
SPANKKI_TLS_CERT=certs/tls.crt
SPANKKI_TLS_KEY=certs/tls.key
SPANKKI_SIGNING_CERT=certs/signing.crt
SPANKKI_SIGNING_KEY=certs/signing.key

# Optional: derived from the signing certificate (decimal serial number / subject DN) if empty.
SPANKKI_SIGNING_KID=
SPANKKI_SIGNING_ISSUER=

LISTEN_ADDR=:8080
